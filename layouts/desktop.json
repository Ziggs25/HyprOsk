{
  "name": "Desktop Layout",
  "mode": "desktop",
  "blur": true,
  "opacity": 0.90,
  "key_opacity": 0.70,
  "margin_bottom": 0,
  "key_spacing": 5.0,
  "row_spacing": 5.0,
  "padding_x": 8.0,
  "padding_y": 8.0,
  "borders": true,
  "layers": {
    "lower": [
      [
        {"key": "Esc", "action": "escape", "width": 1.1},
        {"key": "q", "sub": "1"},
        {"key": "w", "sub": "2"},
        {"key": "e", "sub": "3"},
        {"key": "r", "sub": "4"},
        {"key": "t", "sub": "5"},
        {"key": "y", "sub": "6"},
        {"key": "u", "sub": "7"},
        {"key": "i", "sub": "8"},
        {"key": "o", "sub": "9"},
        {"key": "p", "sub": "0"},
        {"key": "⌫", "action": "backspace", "width": 1.5}
      ],
      [
        {"key": "Tab", "action": "tab", "width": 1.5},
        {"key": "a", "sub": "@"},
        {"key": "s", "sub": "#"},
        {"key": "d", "sub": "$"},
        {"key": "f", "sub": "%"},
        {"key": "g", "sub": "&"},
