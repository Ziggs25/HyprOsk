      [
        {"key": "&123", "action": "symbols", "width": 1.25},
        {"key": "Ctrl", "action": "ctrl", "width": 1.1},
        {"key": "⊞", "action": "win", "width": 1.1},
        {"key": "Alt", "action": "alt", "width": 1.1},
        {"key": "Space", "action": "space", "width": 7.2},
        {"key": "🎤", "action": "none", "width": 1.1},
        {"key": "◀", "action": "left", "width": 1.1},
