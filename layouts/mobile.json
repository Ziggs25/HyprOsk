{
  "name": "Mobile Layout",
  "mode": "mobile",
  "blur": true,
  "opacity": 0.90,
  "key_opacity": 0.90,
  "width": 392,
  "height": 350,
  "margin_bottom": 16,
  "key_spacing": 6.0,
  "row_spacing": 10.0,
  "padding_x": 5.0,
  "padding_y": 8.0,
  "borders": false,
  "matugen": true,
  "matugen_type": "scheme-vibrant",
  "matugen_prefer": "saturation",
  "font_size": 2.0,
  "layers": {
    "lower": [
      [
        {"key": "q", "sub": "1"},
        {"key": "w", "sub": "2"},
        {"key": "e", "sub": "3"},
        {"key": "r", "sub": "4"},
        {"key": "t", "sub": "5"},
        {"key": "y", "sub": "6"},
        {"key": "u", "sub": "7"},
        {"key": "i", "sub": "8"},
        {"key": "o", "sub": "9"},
        {"key": "p", "sub": "0"}
      ],
      [
        {"key": "a", "sub": "@"},
        {"key": "s", "sub": "#"},
        {"key": "d", "sub": "$"},
        {"key": "f", "sub": "%"},
        {"key": "g", "sub": "&"},
        {"key": "h", "sub": "-"},
        {"key": "j", "sub": "+"},
        {"key": "k", "sub": "("},
        {"key": "l", "sub": ")"}
      ],
      [
        {"key": "⇧", "action": "shift", "width": 1.35, "bg_color": "surface_container_high"},
        {"key": "z", "sub": "*"},
        {"key": "x", "sub": "\""},
        {"key": "c", "sub": "'"},
        {"key": "v", "sub": ":"},
        {"key": "b", "sub": ";"},
        {"key": "n", "sub": "!"},
        {"key": "m", "sub": "?"},
        {"key": "⌫", "action": "backspace", "width": 1.35, "bg_color": "surface_container_high"}
      ],
      [
        {"key": "?123", "action": "symbols", "width": 1.35, "bg_color": "surface_container_high"},
        {"key": ",", "width": 1.0},
        {"key": "Space", "action": "space", "width": 4.9},
        {"key": ".", "width": 1.0},
        {"key": "⏎", "action": "enter", "width": 1.35, "bg_color": "surface_container_high"}
      ]
    ],
    "upper": [
      [
        {"key": "Q", "sub": "1"},
        {"key": "W", "sub": "2"},
        {"key": "E", "sub": "3"},
        {"key": "R", "sub": "4"},
        {"key": "T", "sub": "5"},
        {"key": "Y", "sub": "6"},
        {"key": "U", "sub": "7"},
        {"key": "I", "sub": "8"},
        {"key": "O", "sub": "9"},
        {"key": "P", "sub": "0"}
      ],
      [
        {"key": "A", "sub": "@"},
        {"key": "S", "sub": "#"},
        {"key": "D", "sub": "$"},
        {"key": "F", "sub": "%"},
        {"key": "G", "sub": "&"},
        {"key": "H", "sub": "-"},
        {"key": "J", "sub": "+"},
        {"key": "K", "sub": "("},
        {"key": "L", "sub": ")"}
      ],
      [
        {"key": "⇧", "action": "shift", "width": 1.35, "bg_color": "surface_container_high"},
        {"key": "Z", "sub": "*"},
        {"key": "X", "sub": "\""},
        {"key": "C", "sub": "'"},
        {"key": "V", "sub": ":"},
        {"key": "B", "sub": ";"},
        {"key": "N", "sub": "!"},
        {"key": "M", "sub": "?"},
        {"key": "⌫", "action": "backspace", "width": 1.35, "bg_color": "surface_container_high"}
      ],
      [
        {"key": "?123", "action": "symbols", "width": 1.35, "bg_color": "surface_container_high"},
        {"key": ",", "width": 1.0},
        {"key": "Space", "action": "space", "width": 4.9},
        {"key": ".", "width": 1.0},
        {"key": "⏎", "action": "enter", "width": 1.35, "bg_color": "surface_container_high"}
      ]
    ],
    "symbols": [
      [
        "1", "2", "3", "4", "5", "6", "7", "8", "9", "0"
      ],
      [
        "@", "#", "$", "%", "&", "-", "+", "(", ")", "/"
      ],
      [
        {"key": "=\\<", "action": "symbols2", "width": 1.35, "bg_color": "surface_container_high"},
        "*", "\"", "'", ":", ";", "!", "?",
        {"key": "⌫", "action": "backspace", "width": 1.35, "bg_color": "surface_container_high"}
      ],
      [
        {"key": "ABC", "action": "lower", "width": 1.35, "bg_color": "surface_container_high"},
        {"key": ",", "width": 1.0},
        {"key": "Space", "action": "space", "width": 4.9},
        {"key": ".", "width": 1.0},
        {"key": "⏎", "action": "enter", "width": 1.35, "bg_color": "surface_container_high"}
      ]
    ],
    "symbols2": [
      [
        "~", "`", "|", "•", "√", "π", "÷", "×", "¶", "∆"
      ],
      [
        "£", "¢", "€", "¥", "^", "°", "=", "{", "}", "\\"
      ],
      [
        {"key": "?123", "action": "symbols", "width": 1.35, "bg_color": "surface_container_high"},
        "%", "_", ">", "<", "[", "]", "§",
        {"key": "⌫", "action": "backspace", "width": 1.35, "bg_color": "surface_container_high"}
      ],
      [
        {"key": "ABC", "action": "lower", "width": 1.35, "bg_color": "surface_container_high"},
        {"key": ",", "width": 1.0},
        {"key": "Space", "action": "space", "width": 4.9},
        {"key": ".", "width": 1.0},
        {"key": "⏎", "action": "enter", "width": 1.35, "bg_color": "surface_container_high"}
      ]
    ]
  }
