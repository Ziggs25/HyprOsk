import "fonts/DejaVuSans.ttf";
import "fonts/DejaVuSans-Bold.ttf";

export enum KeyType {
    standard,
    space,
    suggestion,
    clipboard-header,
    clipboard-back,
    clipboard-item,
}

export struct Key {
    x: length,
    y: length,
    w: length,
    h: length,
    label: string,
    sub: string,
    icon: int,
    key-type: KeyType,
    is-pressed: bool,
    is-functional: bool,
    is-pinned: bool,
    has-border: bool,
    has-custom-bg: bool,
    bg-color: color,
    has-custom-bg-pressed: bool,
    bg-color-pressed: color,
    has-custom-text: bool,
    text-color: color,
    has-custom-text-pressed: bool,
    text-color-pressed: color,
    has-custom-icon: bool,
    icon-color: color,
    has-custom-icon-pressed: bool,
    icon-color-pressed: color,
    has-custom-border: bool,
    border-color: color,
}

export global OskTheme {
    in-out property <color> dock-bg: #000000;
    in-out property <color> clipboard-bg: #111111;
    in-out property <color> key-bg: #1c1c1c;
    in-out property <color> key-bg-pressed: #141414;
    in-out property <color> text-color: #fff;
    in-out property <color> text-color-pressed: #fff;
    in-out property <color> sub-color: #cdd6f4;
    in-out property <color> icon-color: #fff;
    in-out property <color> icon-color-pressed: #89b4fa;
    in-out property <color> accent-color: #89b4fa;
    in-out property <color> border-color: #585b70;
    in-out property <color> suggest-bg: rgba(255, 255, 255, 0.05);
    in-out property <color> suggest-bg-pressed: rgba(255, 255, 255, 0.18);
    in-out property <color> preview-bg: #2d2d2d;
    in-out property <color> preview-text: #ffffff;
    in-out property <color> preview-border: #444444;
    in-out property <length> preview-font-size: 34px;
    in-out property <length> suggest-text-size: 21px;
    in-out property <length> label-size: 27px;
    in-out property <length> functional-size: 21px;
    in-out property <length> sub-size: 14px;
    in-out property <length> sub-offset-x: 10px;
    in-out property <length> sub-offset-y: 6px;
    in-out property <length> icon-size: 24px;
    in-out property <length> pin-size: 14px;
    in-out property <length> key-radius: 16px;
    in-out property <length> space-radius: 20px;
}

export global OskIcons {
    in-out property <image> backspace;
    in-out property <image> enter;
    in-out property <image> shift;
    in-out property <image> capslock;
    in-out property <image> win;
    in-out property <image> mic;
    in-out property <image> arrow-l;
    in-out property <image> arrow-r;
    in-out property <image> arrow-u;
    in-out property <image> arrow-d;
    in-out property <image> gear;
    in-out property <image> palette;
    in-out property <image> dismiss;
    in-out property <image> clipboard;
    in-out property <image> grave;
    in-out property <image> euro;
    in-out property <image> sterling;
    in-out property <image> yen;
    in-out property <image> cent;
    in-out property <image> rupee;
    in-out property <image> section;
    in-out property <image> plusminus;
    in-out property <image> multiply;
    in-out property <image> divide;
    in-out property <image> notequal;
    in-out property <image> degree;
    in-out property <image> bullet;
    in-out property <image> copyright;
    in-out property <image> registered;
    in-out property <image> trademark;
    in-out property <image> guillemotleft;
    in-out property <image> guillemotright;
    in-out property <image> questiondown;
    in-out property <image> pin;

    public pure function get(code: int) -> image {
        if (code == 1) { return backspace; }
        if (code == 2) { return enter; }
        if (code == 3) { return shift; }
        if (code == 34) { return capslock; }
        if (code == 4) { return win; }
        if (code == 5) { return mic; }
        if (code == 6) { return arrow-l; }
        if (code == 7) { return arrow-r; }
        if (code == 8) { return arrow-u; }
        if (code == 9) { return arrow-d; }
        if (code == 10) { return gear; }
        if (code == 11) { return palette; }
        if (code == 12) { return dismiss; }
        if (code == 13) { return clipboard; }
        if (code == 14) { return grave; }
        if (code == 15) { return euro; }
        if (code == 16) { return sterling; }
        if (code == 17) { return yen; }
        if (code == 18) { return cent; }
        if (code == 19) { return rupee; }
        if (code == 20) { return section; }
        if (code == 21) { return plusminus; }
        if (code == 22) { return multiply; }
        if (code == 23) { return divide; }
        if (code == 24) { return notequal; }
        if (code == 25) { return degree; }
        if (code == 26) { return bullet; }
        if (code == 27) { return copyright; }
        if (code == 28) { return registered; }
        if (code == 29) { return trademark; }
        if (code == 30) { return guillemotleft; }
        if (code == 31) { return guillemotright; }
        if (code == 32) { return questiondown; }
        return pin;
    }
}

component KeyVisual {
    in property <Key> k;
    in property <length> origin-y: 0px;
    in property <bool> clip-card-items: false;

    width: k.w;
    height: k.h;
    x: k.x;
    y: k.y - root.origin-y;

    property <bool> is-clipboard: k.key-type == KeyType.clipboard-header
                                || k.key-type == KeyType.clipboard-back
                                || k.key-type == KeyType.clipboard-item;

    property <bool> is-clipboard-item: k.key-type == KeyType.clipboard-item;
    visible: root.clip-card-items
        ? root.is-clipboard-item
        : (!root.is-clipboard-item && !(k.key-type == KeyType.suggestion && k.label == ""));
    opacity: (k.key-type == KeyType.suggestion && k.label == "") ? 0.0 : 1.0;

    if k.key-type == KeyType.clipboard-header : Rectangle {
        background: transparent;
        Text {
            x: 0; y: 0; width: parent.width - 30px; height: parent.height;
            text: k.label;
            font-size: 19px;
            font-weight: 600;
            color: #e0e0e0;
            horizontal-alignment: left;
            vertical-alignment: center;
        }
        Image {
            x: parent.width - 22px; y: (parent.height - 16px) / 2;
            width: 16px; height: 16px;
            source: OskIcons.pin;
            colorize: OskTheme.accent-color;
            visible: false;
        }
    }

    if k.key-type == KeyType.clipboard-back : Rectangle {
        background: k.is-pressed ? OskTheme.key-bg-pressed : OskTheme.key-bg;
        border-radius: 12px;
        Text {
            x: 0; y: 0; width: parent.width; height: parent.height;
            text: "⌨ Back";
            font-size: 15px;
            font-weight: 500;
            color: k.is-pressed ? OskTheme.text-color-pressed : OskTheme.text-color;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if k.key-type == KeyType.clipboard-item : Rectangle {
        x: k.is-pressed ? 1px : 0px;
        y: k.is-pressed ? 1px : 0px;
        width: k.w - (k.is-pressed ? 2px : 0px);
        height: k.h - (k.is-pressed ? 2px : 0px);
        background: k.is-pressed ? OskTheme.key-bg-pressed : OskTheme.key-bg;
        border-radius: 16px;
        Text {
            x: 12px; y: 10px; width: parent.width - 36px; height: parent.height - 20px;
            text: k.label;
            font-size: 17px;
            color: k.is-pressed ? OskTheme.text-color-pressed : OskTheme.text-color;
            horizontal-alignment: left;
            vertical-alignment: top;
            wrap: word-wrap;
        }
        Image {
            visible: k.is-pinned;
            x: parent.width - 18px; y: 8px; width: OskTheme.pin-size; height: OskTheme.pin-size;
            source: OskIcons.pin;
            colorize: OskTheme.accent-color;
        }
    }

    if !root.is-clipboard : Rectangle {
        x: k.is-pressed ? 2px : 0px;
        y: k.is-pressed ? 2px : 0px;
        width: k.w - (k.is-pressed ? 4px : 0px);
        height: k.h - (k.is-pressed ? 4px : 0px);
        background: k.is-pressed
            ? (k.has-custom-bg-pressed
                ? k.bg-color-pressed
                : (k.has-custom-bg
                    ? k.bg-color.darker(0.2)
                    : (k.key-type == KeyType.suggestion
                        ? OskTheme.suggest-bg-pressed.darker(0.2)
                        : OskTheme.key-bg-pressed.darker(0.2))))
            : (k.has-custom-bg
                ? k.bg-color
                : (k.key-type == KeyType.suggestion
                    ? OskTheme.suggest-bg
                    : (k.icon == 34 ? OskTheme.key-bg-pressed : (k.has-border ? OskTheme.key-bg : transparent))));
        border-color: k.has-custom-border ? k.border-color : transparent;
        border-width: k.has-custom-border ? 1px : 0px;
        border-radius: k.key-type == KeyType.suggestion ? 8px : (k.key-type == KeyType.space ? OskTheme.space-radius : OskTheme.key-radius);

        Image {
            visible: k.icon > 0 && k.key-type != KeyType.suggestion;
            x: (parent.width - OskTheme.icon-size) / 2;
            y: (parent.height - OskTheme.icon-size) / 2;
            width: OskTheme.icon-size;
            height: OskTheme.icon-size;
            source: OskIcons.get(k.icon);
            colorize: k.is-pressed
                ? (k.has-custom-icon-pressed
                    ? k.icon-color-pressed
                    : (k.has-custom-icon
                        ? k.icon-color
                        : OskTheme.icon-color-pressed))
                : (k.has-custom-icon
                    ? k.icon-color
                    : ((k.icon == 34) ? OskTheme.icon-color-pressed : OskTheme.icon-color));
            image-fit: contain;
        }
        Text {
            visible: k.icon <= 0 && k.key-type != KeyType.suggestion;
            x: 0; y: 0; width: parent.width; height: parent.height;
            text: k.label;
            font-family: "DejaVu Sans";
            font-size: k.is-functional ? OskTheme.functional-size : OskTheme.label-size;
            font-weight: 500;
            color: k.is-pressed
                ? (k.has-custom-text-pressed
                    ? k.text-color-pressed
                    : (k.has-custom-text
                        ? k.text-color
                        : OskTheme.text-color-pressed))
                : (k.has-custom-text
                    ? k.text-color
                    : OskTheme.text-color);
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Text {
            visible: k.key-type == KeyType.suggestion;
            x: 0; y: 0; width: parent.width; height: parent.height;
            text: k.label;
            font-family: "DejaVu Sans";
            font-size: OskTheme.suggest-text-size;
            font-weight: 500;
            color: k.is-pressed ? OskTheme.text-color-pressed : OskTheme.text-color;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Text {
            visible: k.key-type != KeyType.suggestion && k.sub != "";
            x: OskTheme.sub-offset-x; y: OskTheme.sub-offset-y; width: 40px; height: 18px;
            text: k.sub;
            font-family: "DejaVu Sans";
            font-size: OskTheme.sub-size;
            font-weight: 500;
            color: OskTheme.sub-color;
        }
    }
}

export component OskUi inherits Window {
    default-font-family: "DejaVu Sans";
    default-font-size: 22px;
    default-font-weight: 500;
    background: transparent;

    // Pre-cache exact rasterization sizes for crisp font rendering (avoids fuzzy runtime bitmap downscaling)
    Text { visible: false; text: "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_+-=[]{}|;':\",./<>?`~•√π÷×¶∆£¢€¥^°§«»¿≠±©®™⌫⏎⇧⇪␣⌨◀▶▲▼123"; font-size: 22px; font-weight: 500; }
    Text { visible: false; text: "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_+-=[]{}|;':\",./<>?`~•√π÷×¶∆£¢€¥^°§«»¿≠±©®™⌫⏎⇧⇪␣⌨◀▶▲▼123"; font-size: 27px; font-weight: 500; }
    Text { visible: false; text: "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_+-=[]{}|;':\",./<>?`~•√π÷×¶∆£¢€¥^°§«»¿≠±©®™⌫⏎⇧⇪␣⌨◀▶▲▼123"; font-size: 16px; font-weight: 500; }
    Text { visible: false; text: "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_+-=[]{}|;':\",./<>?`~•√π÷×¶∆£¢€¥^°§«»¿≠±©®™⌫⏎⇧⇪␣⌨◀▶▲▼123"; font-size: 21px; font-weight: 500; }
    Text { visible: false; text: "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_+-=[]{}|;':\",./<>?`~•√π÷×¶∆£¢€¥^°§«»¿≠±©®™⌫⏎⇧⇪␣⌨◀▶▲▼123"; font-size: 11px; font-weight: 500; }
    Text { visible: false; text: "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_+-=[]{}|;':\",./<>?`~•√π÷×¶∆£¢€¥^°§«»¿≠±©®™⌫⏎⇧⇪␣⌨◀▶▲▼123"; font-size: 14px; font-weight: 500; }

    in-out property <[Key]> keys;
    in property <bool> show-clipboard: false;
    in property <bool> clipboard-scrollbar-visible: false;
    in property <float> clipboard-scroll-ratio: 0;
    in property <length> clipboard-panel-top: 0px;
    in property <length> clipboard-panel-height: 0px;
    in property <length> clipboard-viewport-top: 0px;
    in property <length> clipboard-viewport-height: 0px;
    in property <length> clipboard-scrollbar-travel: 0px;
    in property <bool> hold-preview-visible: false;
    in property <string> hold-preview-label: "";
    in property <length> hold-preview-x;
    in property <length> hold-preview-y;
    in property <length> hold-preview-w;
    in property <length> hold-preview-h;

    Rectangle {
        background: OskTheme.dock-bg;
    }

    Rectangle {
        visible: root.show-clipboard && root.clipboard-viewport-height > 0px;
        x: 8px;
        y: root.clipboard-panel-top;
        width: parent.width - 16px;
        height: root.clipboard-panel-height;
        background: OskTheme.clipboard-bg;
        border-radius: 14px;
    }

    for k in root.keys: KeyVisual {
        k: k;
    }

    Rectangle {
        x: 0px;
        y: root.clipboard-viewport-top;
        width: parent.width;
        height: root.clipboard-viewport-height;
        clip: true;
        background: transparent;

        for k in root.keys: KeyVisual {
            k: k;
            origin-y: root.clipboard-viewport-top;
            clip-card-items: true;
        }

        // Keep the indicator inside the same bounds as card drawing and taps.
        Rectangle {
            visible: root.show-clipboard && root.clipboard-scrollbar-visible;
            x: 12px;
            y: root.clipboard-scroll-ratio * root.clipboard-scrollbar-travel;
            width: 4px;
            height: 36px;
            background: OskTheme.accent-color;
            border-radius: 2px;
            opacity: 0.85;
        }
    }

    Rectangle {
        visible: root.hold-preview-visible;
        x: root.hold-preview-x;
        y: root.hold-preview-y;
        width: root.hold-preview-w;
        height: root.hold-preview-h;
        background: OskTheme.preview-bg;
        border-radius: 14px;
        border-width: 1px;
        border-color: OskTheme.preview-border;
        Text {
            x: 0;
            y: 12px;
            width: parent.width;
            height: 56px;
            text: root.hold-preview-label;
            font-size: OskTheme.preview-font-size;
            font-weight: 600;
            color: OskTheme.preview-text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Rectangle {
            x: (parent.width - 14px) / 2;
            y: parent.height - 1px;
            width: 14px;
            height: 7px;
            background: OskTheme.preview-bg;
        }
    }
}