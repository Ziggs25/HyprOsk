import "fonts/DejaVuSans.ttf";

export enum KeyType {
    standard,
    space,
    suggestion,
    clipboard-header,
    clipboard-back,
    clipboard-item,
}

export struct Key {
    x: length,
    y: length,
    w: length,
    h: length,
    label: string,
    sub: string,
    icon: int,
    key-type: KeyType,
    is-pressed: bool,
    is-functional: bool,
    is-pinned: bool,
}

export global OskTheme {
    in-out property <color> dock-bg: #000000;
    in-out property <color> clipboard-bg: #111111;
    in-out property <color> key-bg: #1c1c1c;
    in-out property <color> key-bg-pressed: #141414;
    in-out property <color> text-color: #fff;
    in-out property <color> sub-color: #8c8c8c;
    in-out property <color> suggest-bg: rgba(255, 255, 255, 0.05);
    in-out property <color> suggest-bg-pressed: rgba(255, 255, 255, 0.18);
    in-out property <length> suggest-text-size: 21px;
    in-out property <length> label-size: 27px;
    in-out property <length> sub-size: 14px;
    in-out property <length> icon-size: 24px;
    in-out property <length> pin-size: 14px;
    in-out property <length> key-radius: 16px;
    in-out property <length> space-radius: 20px;
}

export global OskIcons {
    in-out property <image> backspace;
    in-out property <image> enter;
    in-out property <image> shift;
    in-out property <image> capslock;
    in-out property <image> win;
    in-out property <image> mic;
    in-out property <image> arrow-l;
    in-out property <image> arrow-r;
    in-out property <image> arrow-u;
    in-out property <image> arrow-d;
    in-out property <image> gear;
    in-out property <image> palette;
    in-out property <image> dismiss;
    in-out property <image> clipboard;
    in-out property <image> grave;
    in-out property <image> euro;
    in-out property <image> sterling;
    in-out property <image> yen;
    in-out property <image> cent;
    in-out property <image> rupee;
    in-out property <image> section;
    in-out property <image> plusminus;
    in-out property <image> multiply;
    in-out property <image> divide;
    in-out property <image> notequal;
    in-out property <image> degree;
    in-out property <image> bullet;
    in-out property <image> copyright;
    in-out property <image> registered;
    in-out property <image> trademark;
    in-out property <image> guillemotleft;
    in-out property <image> guillemotright;
    in-out property <image> questiondown;
    in-out property <image> pin;

    public pure function get(code: int) -> image {
        if (code == 1) { return backspace; }
        if (code == 2) { return enter; }
        if (code == 3) { return shift; }
        if (code == 34) { return capslock; }
        if (code == 4) { return win; }
        if (code == 5) { return mic; }
        if (code == 6) { return arrow-l; }
        if (code == 7) { return arrow-r; }
        if (code == 8) { return arrow-u; }
        if (code == 9) { return arrow-d; }
        if (code == 10) { return gear; }
        if (code == 11) { return palette; }
        if (code == 12) { return dismiss; }
        if (code == 13) { return clipboard; }
        if (code == 14) { return grave; }
        if (code == 15) { return euro; }
        if (code == 16) { return sterling; }
        if (code == 17) { return yen; }
        if (code == 18) { return cent; }
        if (code == 19) { return rupee; }
        if (code == 20) { return section; }
        if (code == 21) { return plusminus; }
        if (code == 22) { return multiply; }
        if (code == 23) { return divide; }
        if (code == 24) { return notequal; }
        if (code == 25) { return degree; }
        if (code == 26) { return bullet; }
        if (code == 27) { return copyright; }
        if (code == 28) { return registered; }
        if (code == 29) { return trademark; }
        if (code == 30) { return guillemotleft; }
        if (code == 31) { return guillemotright; }
        if (code == 32) { return questiondown; }
        return pin;
    }
}

component KeyVisual {
    in property <Key> k;

    width: k.w;
    height: k.h;
    x: k.x;
    y: k.y;

    property <bool> is-clipboard: k.key-type == KeyType.clipboard-header
                                || k.key-type == KeyType.clipboard-back
                                || k.key-type == KeyType.clipboard-item;

    visible: !(k.key-type == KeyType.suggestion && k.label == "");
    opacity: (k.key-type == KeyType.suggestion && k.label == "") ? 0.0 : 1.0;

    if k.key-type == KeyType.clipboard-header : Rectangle {
        background: transparent;
        Text {
            x: 0; y: 0; width: parent.width - 30px; height: parent.height;
            text: k.label;
            font-size: 19px;
            font-weight: 600;
            color: #e0e0e0;
            horizontal-alignment: left;
            vertical-alignment: center;
        }
        Image {
            x: parent.width - 22px; y: (parent.height - 16px) / 2;
            width: 16px; height: 16px;
            source: OskIcons.pin;
            colorize: #89b4fa;
            visible: false;
        }
    }

    if k.key-type == KeyType.clipboard-back : Rectangle {
        background: k.is-pressed ? #333333 : #222222;
        border-radius: 12px;
        Text {
            x: 0; y: 0; width: parent.width; height: parent.height;
            text: "⌨ Back";
            font-size: 15px;
            font-weight: 500;
            color: #fff;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if k.key-type == KeyType.clipboard-item : Rectangle {
        x: k.is-pressed ? 1px : 0px;
        y: k.is-pressed ? 1px : 0px;
        width: k.w - (k.is-pressed ? 2px : 0px);
        height: k.h - (k.is-pressed ? 2px : 0px);
        background: k.is-pressed ? OskTheme.key-bg-pressed : OskTheme.key-bg;
        border-radius: 14px;
        Text {
            x: 10px; y: 8px; width: parent.width - 20px; height: parent.height - 16px;
            text: k.label;
            font-size: 15px;
            color: #fff;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }
        Image {
            visible: k.is-pinned;
            x: parent.width - 18px; y: 8px; width: OskTheme.pin-size; height: OskTheme.pin-size;
            source: OskIcons.pin;
            colorize: #89b4fa;
        }
    }

    if !root.is-clipboard : Rectangle {
        x: k.is-pressed ? 2px : 0px;
        y: k.is-pressed ? 2px : 0px;
        width: k.w - (k.is-pressed ? 4px : 0px);
        height: k.h - (k.is-pressed ? 4px : 0px);
        background: k.key-type == KeyType.suggestion
            ? (k.is-pressed ? OskTheme.suggest-bg-pressed : OskTheme.suggest-bg)
            : (k.icon == 34 ? #363a4f : (k.is-pressed ? OskTheme.key-bg-pressed : OskTheme.key-bg));
        border-color: k.icon == 34 ? #89b4fa : (k.is-pressed ? #585b70 : transparent);
        border-width: (k.icon == 34 || k.is-pressed) ? 1.5px : 0px;
        border-radius: k.key-type == KeyType.suggestion ? 8px : (k.key-type == KeyType.space ? OskTheme.space-radius : OskTheme.key-radius);

        Image {
            visible: k.icon > 0 && k.key-type != KeyType.suggestion;
            x: (parent.width - OskTheme.icon-size) / 2;
            y: (parent.height - OskTheme.icon-size) / 2;
            width: OskTheme.icon-size;
            height: OskTheme.icon-size;
            source: OskIcons.get(k.icon);
            colorize: (k.icon == 34 || k.is-pressed) ? #89b4fa : #ffffff;
            image-fit: contain;
        }
        Text {
            visible: k.icon <= 0 && k.key-type != KeyType.suggestion;
            x: 0; y: 0; width: parent.width; height: parent.height;
            text: k.label;
            font-size: k.is-functional ? 21px : OskTheme.label-size;
            font-weight: 400;
            color: OskTheme.text-color;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Text {
            visible: k.key-type == KeyType.suggestion;
            x: 0; y: 0; width: parent.width; height: parent.height;
            text: k.label;
            font-size: OskTheme.suggest-text-size;
            font-weight: 500;
            color: OskTheme.text-color;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Text {
            visible: k.key-type != KeyType.suggestion && k.sub != "";
            x: 10px; y: 6px; width: 40px; height: 18px;
            text: k.sub;
            font-size: OskTheme.sub-size;
            color: OskTheme.sub-color;
        }
    }
}

export component OskUi inherits Window {
    default-font-family: "DejaVu Sans";
    default-font-size: 27px;
    background: transparent;

    in-out property <[Key]> keys;
    in property <bool> show-clipboard: false;
    in property <bool> hold-preview-visible: false;
    in property <string> hold-preview-label: "";
    in property <length> hold-preview-x;
    in property <length> hold-preview-y;
    in property <length> hold-preview-w;
    in property <length> hold-preview-h;

    Rectangle {
        background: OskTheme.dock-bg;
    }

    Rectangle {
        visible: root.show-clipboard;
        x: 8px;
        y: 62px;
        width: parent.width - 16px;
        height: parent.height - 70px;
        background: OskTheme.clipboard-bg;
        border-radius: 14px;
    }

    for k in keys: KeyVisual {
        k: k;
    }

    Rectangle {
        visible: root.hold-preview-visible;
        x: root.hold-preview-x;
        y: root.hold-preview-y;
        width: root.hold-preview-w;
        height: root.hold-preview-h;
        background: #2d2d2d;
        border-radius: 12px;
        border-width: 1px;
        border-color: #444444;
        Text {
            x: 0; y: 0; width: parent.width; height: parent.height;
            text: root.hold-preview-label;
            font-size: 34px;
            font-weight: 600;
            color: #ffffff;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Rectangle {
            x: (parent.width - 12px) / 2;
            y: parent.height - 1px;
            width: 12px;
            height: 6px;
            background: #2d2d2d;
        }
    }
}